// ═════════════════════ Integrations vault & messaging (M22, M09, M10) ═════════════════════

enum IntegrationKind {
  PESAPAL
  SMS_AFRICASTALKING
  WHATSAPP_CLOUD
  SMTP
}

enum IntegrationMode {
  TEST
  LIVE
}

/// Provider keys live here, sealed with AES-256-GCM. Never sent to a browser.
model Integration {
  kind            IntegrationKind @id
  enabled         Boolean         @default(false)
  mode            IntegrationMode @default(TEST)
  /// Non-secret settings (sender ID, phone number ID, username, host…)
  config          Json            @default("{}")
  /// Sealed JSON of the secret fields
  secretsEnc      String?
  /// Last four characters of each secret, for display
  secretHints     Json            @default("{}")
  lastTestAt      DateTime?
  lastTestOk      Boolean?
  lastTestMessage String?
  updatedById     String?         @db.Uuid
  updatedAt       DateTime        @updatedAt
}

enum MessageChannel {
  EMAIL
  SMS
  WHATSAPP
}

/// The words guests receive, editable by the owner. {{variables}} are filled at send time.
model MessageTemplate {
  id               String         @id @default(uuid(7)) @db.Uuid
  key              String
  channel          MessageChannel
  locale           String         @default("en")
  subject          String?
  heading          String?
  body             String
  actionLabel      String?
  /// WhatsApp Cloud API: the approved template name at Meta (business-initiated messages need one)
  providerTemplate String?
  isActive         Boolean        @default(true)
  updatedById      String?        @db.Uuid
  updatedAt        DateTime       @updatedAt
  createdAt        DateTime       @default(now())

  @@unique([key, channel, locale])
}

enum OutboundStatus {
  QUEUED
  SENT
  FAILED
  /// Written down but not sent: the channel is not connected yet (a wa.me link is kept for staff)
  NOT_CONNECTED
  SKIPPED
}

/// Every message the house sends a guest, whatever the channel.
model OutboundMessage {
  id            String         @id @default(uuid(7)) @db.Uuid
  channel       MessageChannel
  to            String
  templateKey   String?
  subject       String?
  body          String
  status        OutboundStatus @default(QUEUED)
  provider      String?
  providerRef   String?
  error         String?
  attempts      Int            @default(0)
  /// For NOT_CONNECTED WhatsApp: a click-to-send link for staff
  fallbackUrl   String?
  reservationId String?        @db.Uuid
  contactId     String?        @db.Uuid
  sentById      String?        @db.Uuid
  isSeed        Boolean        @default(false)
  createdAt     DateTime       @default(now())
  sentAt        DateTime?

  @@index([createdAt])
  @@index([reservationId, templateKey])
}

/// One-time codes for guests finding their stay by phone (only when SMS is live).
model StayOtp {
  id        String    @id @default(uuid(7)) @db.Uuid
  code      String
  phone     String
  codeHash  String
  attempts  Int       @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([code, phone])
}

// ═════════════════════════ Movement III — the Walk (M04) ═════════════════════════

enum TourSpace {
  LOBBY
  ROOM_TYPE
  HALL
  COMPOUND
  BEYOND
}

enum TourProvider {
  MATTERPORT
  KUULA
  VIDEO
  CUSTOM_URL
  /// A walk through drawings or photos in the media library, before a scan exists
  DRAWINGS
}

enum TourStage {
  PRE_OPENING
  LIVE
}

enum TourVariant {
  EMPTY
  SET
}

/// One walk-through. A slot is space + room type + variant; a published LIVE tour replaces the PRE_OPENING one in the same slot.
model Tour {
  id         String        @id @default(uuid(7)) @db.Uuid
  slug       String        @unique
  title      Json
  summary    Json          @default("{}")
  space      TourSpace
  roomTypeId String?       @db.Uuid
  variant    TourVariant?
  provider   TourProvider
  /// Normalised embed URL (iframe providers)
  embedUrl   String?
  /// DRAWINGS: the frames, in walking order
  mediaIds   String[]      @default([])
  posterId   String?       @db.Uuid
  stage      TourStage     @default(PRE_OPENING)
  status     ContentStatus @default(DRAFT)
  order      Int           @default(0)
  isSeed     Boolean       @default(false)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  deletedAt  DateTime?

  roomType RoomType?     @relation(fields: [roomTypeId], references: [id], onDelete: SetNull)
  poster   MediaAsset?   @relation("TourPoster", fields: [posterId], references: [id], onDelete: SetNull)
  hotspots TourHotspot[]
  events   TourEvent[]

  @@index([space, roomTypeId, variant, stage, status])
}

enum HotspotKind {
  BED
  BATH
  VIEW
  CAPACITY
  ACCESS
  OTHER
}

/// A labelled fact inside a tour. For DRAWINGS it sits on a frame at (x, y) in 0..1.
model TourHotspot {
  id          String      @id @default(uuid(7)) @db.Uuid
  tourId      String      @db.Uuid
  kind        HotspotKind
  label       Json
  note        Json        @default("{}")
  providerRef String?
  frame       Int?        @db.SmallInt
  x           Float?
  y           Float?
  order       Int         @default(0)

  tour Tour @relation(fields: [tourId], references: [id], onDelete: Cascade)
}

enum TourEventKind {
  OPENED
  COMPLETED
  HOTSPOT
  CTA_CLICK
}

enum TourContext {
  ROOM_PAGE
  CHECKOUT
  PAGE
}

/// Anonymous: a random session id from the browser, never a person.
model TourEvent {
  id        String        @id @default(uuid(7)) @db.Uuid
  tourId    String        @db.Uuid
  sessionId String
  event     TourEventKind
  context   TourContext
  createdAt DateTime      @default(now())

  tour Tour @relation(fields: [tourId], references: [id], onDelete: Cascade)

  @@index([tourId, createdAt])
  @@index([sessionId])
}

// ═════════════════════════ Receipts, refunds and invoices ═════════════════════════

enum DocumentKind {
  RECEIPT
  REFUND
  INVOICE
}

/// A numbered document given to a guest. Immutable once issued: corrections void it and issue a new one.
model IssuedDocument {
  id              String       @id @default(uuid(7)) @db.Uuid
  kind            DocumentKind
  /// e.g. RCT-2026-00042 — gap-free within its series
  number          String       @unique
  year            Int          @db.SmallInt
  seq             Int
  reservationId   String?      @db.Uuid
  /// One receipt per payment (and one refund note per refund line)
  paymentIntentId String?      @unique @db.Uuid
  folioLineId     String?      @unique @db.Uuid
  currency        Currency
  amountMinor     BigInt
  issuedTo        Json
  /// Everything printed, frozen at issue time (hotel details, lines, tax, balance)
  data            Json
  issuedAt        DateTime     @default(now())
  issuedById      String?      @db.Uuid
  voidedAt        DateTime?
  voidedById      String?      @db.Uuid
  voidReason      String?
  replacesId      String?      @db.Uuid
  printCount      Int          @default(0)
  lastPrintedAt   DateTime?
  sentAt          DateTime?
  isSeed          Boolean      @default(false)

  @@index([reservationId])
  @@index([kind, issuedAt])
}

/// Gap-free counters for document numbers (one row per series and year).
model DocumentSequence {
  series String @id
  next   Int    @default(1)
}

