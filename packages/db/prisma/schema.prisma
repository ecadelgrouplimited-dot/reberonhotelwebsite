  createdAt     DateTime @default(now())

  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  lines       FolioLine[]
}

/// Append-only ledger. Charges positive, payments/refunds negative. Corrections are reversing lines.
model FolioLine {
  id             String        @id @default(uuid(7)) @db.Uuid
  folioId        String        @db.Uuid
  kind           FolioLineKind
  description    String
  date           DateTime      @db.Date
