  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
}

model ReservationChange {
  id            String   @id @default(uuid(7)) @db.Uuid
  reservationId String   @db.Uuid
  kind          String
  summary       String
  before        Json?
  after         Json?
  actorId       String?  @db.Uuid
