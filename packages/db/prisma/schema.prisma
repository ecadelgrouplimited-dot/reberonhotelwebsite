model StockMovement {
  id             String            @id @default(uuid(7)) @db.Uuid
  itemId         String            @db.Uuid
  type           StockMovementType
  quantity       Int
  balanceAfter   Int
  department     String?
  reference      String?
  notes          String?
  recordedById   String?           @db.Uuid
  recordedByName String?
  isSeed         Boolean           @default(false)
  createdAt      DateTime          @default(now())

  item InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId, createdAt])
}

model Requisition {
  id                   String            @id @default(uuid(7)) @db.Uuid
  number               String            @unique
  department           Department
  title                String
  priority             String            @default("NORMAL")
  status               RequisitionStatus @default(PENDING)
  currency             Currency          @default(UGX)
  totalEstimatedMinor  BigInt
  notes                String?
  rejectionReason      String?
  requestedById        String?           @db.Uuid
  requestedByName      String
  managerApprovedById  String?           @db.Uuid
  managerApprovedBy    String?
  managerApprovedAt    DateTime?
  directorApprovedById String?           @db.Uuid
  directorApprovedBy   String?
  directorApprovedAt   DateTime?
  disbursedById        String?           @db.Uuid
  disbursedBy          String?
  disbursedAt          DateTime?
  isSeed               Boolean           @default(false)
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  items RequisitionItem[]

  @@index([status, createdAt])
  @@index([department])
}

model RequisitionItem {
  id                  String  @id @default(uuid(7)) @db.Uuid
  requisitionId       String  @db.Uuid
  inventoryItemId     String? @db.Uuid
  itemName            String
  unit                String  @default("PIECE")
  quantityRequested   Int
  quantityApproved    Int?
  estimatedUnitMinor  BigInt
  totalEstimatedMinor BigInt

  requisition Requisition @relation(fields: [requisitionId], references: [id], onDelete: Cascade)

  @@index([requisitionId])
}

model StaffAnnouncement {
  id         String      @id @default(uuid(7)) @db.Uuid
  department Department?
  title      String
  body       String
  priority   String      @default("NORMAL")
  authorId   String?     @db.Uuid
  authorName String
  authorRole String?
  isPinned   Boolean     @default(false)
  isSeed     Boolean     @default(false)
  createdAt  DateTime    @default(now())

  @@index([isPinned, createdAt])
}

model TerminalDevice {
  id         String     @id @default(uuid(7)) @db.Uuid
  code       String     @unique
  name       String
  department Department
  kind       String     @default("POS_TERMINAL")
  paperSize  String     @default("80MM")
  ipOrPort   String?
  status     String     @default("ONLINE")
  lastSeenAt DateTime   @default(now())
  isSeed     Boolean    @default(false)
}
