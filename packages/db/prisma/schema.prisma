  folio Folio @relation(fields: [folioId], references: [id], onDelete: Cascade)

  @@index([folioId, createdAt])
}

enum PaymentPurpose {
  DEPOSIT
  FULL
  BALANCE
  EXTRA
}

enum PaymentMethod {
  MOBILE_MONEY
  CARD
  CASH
  BANK
  UNKNOWN
}

enum PaymentProvider {
  PESAPAL
  TEST
  MANUAL
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  EXPIRED
  REFUNDED
}

model PaymentIntent {
  id                 String          @id @default(uuid(7)) @db.Uuid
  reservationId      String          @db.Uuid
  purpose            PaymentPurpose
  amountMinor        BigInt
  currency           Currency
  method             PaymentMethod   @default(UNKNOWN)
