  extraId       String?            @db.Uuid
  note          String?
  status        GuestRequestStatus @default(NEW)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
}

// ═════════════════════════ Movement IV — the House ═════════════════════════

/// A numbered room given to a reservation for some of its nights (check-in, room moves).
model RoomAssignment {
  id                String    @id @default(uuid(7)) @db.Uuid
  reservationId     String    @db.Uuid
  reservationRoomId String    @db.Uuid
  roomId            String    @db.Uuid
  fromDate          DateTime  @db.Date
  toDate            DateTime  @db.Date
  releasedAt        DateTime?
  createdById       String?   @db.Uuid
  createdAt         DateTime  @default(now())

  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  room        Room        @relation(fields: [roomId], references: [id], onDelete: Restrict)

  @@index([roomId, fromDate, toDate])
}

enum HkTaskKind {
  DEPARTURE
  STAYOVER
  INSPECTION
  DEEP_CLEAN
  MAINTENANCE
}

enum HkTaskStatus {
  TODO
  IN_PROGRESS
  DONE
  INSPECTED
  SKIPPED
}

model HousekeepingTask {
  id            String       @id @default(uuid(7)) @db.Uuid
  roomId        String       @db.Uuid
  date          DateTime     @db.Date
  kind          HkTaskKind
  status        HkTaskStatus @default(TODO)
  priority      Int          @default(0) @db.SmallInt
  assigneeId    String?      @db.Uuid
  notes         String?
  startedAt     DateTime?
  completedAt   DateTime?
  completedById String?      @db.Uuid
  inspectedAt   DateTime?
  inspectedById String?      @db.Uuid
  isSeed        Boolean      @default(false)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

