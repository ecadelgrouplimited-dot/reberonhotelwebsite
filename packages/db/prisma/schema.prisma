/// Every provider notification, stored once (providerEventId unique) — webhooks are safe to receive twice.
model PaymentEvent {
  id              String          @id @default(uuid(7)) @db.Uuid
  paymentIntentId String?         @db.Uuid
  provider        PaymentProvider
  providerEventId String          @unique
  payload         Json
  processedAt     DateTime?
  createdAt       DateTime        @default(now())

  paymentIntent PaymentIntent? @relation(fields: [paymentIntentId], references: [id], onDelete: SetNull)
}

enum GuestRequestKind {
  EXTRA
