    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@next/env": "^16.3.7",
    "@reberon/contracts": "workspace:*",
    "@reberon/ui": "workspace:*",
    "@reberon/utils": "workspace:*",
    "clsx": "^2.1.1",
    "lenis": "^1.3.26",
    "lucide-react": "^1.48.0",
    "next": "^16.3.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@reberon/config": "workspace:*",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3"
  }
