{
  "name": "reberon-hotel-suite",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "NODE_OPTIONS=\"--dns-result-order=ipv4first\" turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "infra:up": "docker compose -f infra/docker-compose.yml up -d --wait",
    "infra:down": "docker compose -f infra/docker-compose.yml down",
    "db:generate": "pnpm --filter @reberon/db generate",
    "db:migrate": "pnpm --filter @reberon/db migrate",
    "db:seed": "pnpm --filter @reberon/db seed",
    "db:seed:ref": "pnpm --filter @reberon/db seed:ref",
    "db:seed:refresh": "pnpm --filter @reberon/db seed:refresh",
    "db:purge-demo": "pnpm --filter @reberon/db purge-demo",
    "db:reset": "pnpm --filter @reberon/db reset",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "prettier": "^3.6.0",
    "turbo": "^2.11.5",
    "typescript": "~5.9.3"
  }
}
