# Copy to .env.production on the server (never commit it). See docs/planning/13-deployment.md.

# ── Names ──
SITE_DOMAIN=reberonhotel.com
ADMIN_DOMAIN=house.reberonhotel.com
API_DOMAIN=api.reberonhotel.com
ACME_EMAIL=it@ecadelgroup.com
# "production" lets search engines in. Use "staging" for a test server.
SITE_ENV=production

# ── Secrets: generate each with  openssl rand -base64 48 ──
POSTGRES_PASSWORD=
JWT_SECRET=
REVALIDATE_SECRET=
PREVIEW_SECRET=
# Encrypts guest ID numbers and the integrations vault. Keep a copy offline: without it they cannot be read.
DATA_KEY=

# ── Email (fallback; can also be set in the House → Integrations) ──
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Reberon Hotel <alerts@reberonhotel.com>"

# ── Payments ──
# Keys are best entered in the House → Integrations (encrypted there).
# These are only a fallback. TEST payments are refused in production.
PAYMENT_PROVIDER=PESAPAL
PESAPAL_ENV=live
PESAPAL_CONSUMER_KEY=
PESAPAL_CONSUMER_SECRET=
BOOKING_HOLD_MINUTES=20

# ── Cloudflare Turnstile for public forms (optional) ──
TURNSTILE_SECRET=
